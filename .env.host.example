COMPOSE_PROJECT_NAME=association-org
HTTP_PORT=8081

# Public canonical URLs; no trailing slash. Usually these are identical.
WP_HOME=https://association.org
WP_SITEURL=https://association.org

DB_NAME=association_wp
DB_USER=association_wp
WP_TABLE_PREFIX=wp_

MARIADB_SOCKET_DIR=/run/mysqld
DB_HOST=localhost:/run/mysqld/mysqld.sock

WORDPRESS_IMAGE=wordpress:7.0-php8.3-fpm-alpine
NGINX_IMAGE=nginx:1.30-alpine

WP_MEM_LIMIT=512m
NGINX_MEM_LIMIT=64m
